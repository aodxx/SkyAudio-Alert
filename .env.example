# 🔒 FLOOD-FIRST CONFIGURATION LOCK — 2026-10-04

# SkyAudio-Alert — Flood-first configuration
# Copy to .env for local testing only. Never commit real secrets.

RUN_MODE=test
DRY_RUN=true

LOCATION_NAME=บ้านลำพาย
DISTRICT_NAME=ต.โคกชะงาย
PROVINCE_NAME=พัทลุง
WEATHER_LAT=7.619729
WEATHER_LON=100.005932
WEATHER_TIMEZONE=Asia/Bangkok

# Primary flood source. Current adapter is strict HTML, not a guaranteed API.
FLOOD_SOURCE_URL=https://chachoengsao-flood.vercel.app/phatthalung
FLOOD_FRESHNESS_LIMIT_MINUTES=180
FLOOD_DEGRADED_MODE=unknown-weather
WEATHER_PAGE_SOURCE_URL=https://chachoengsao-flood.vercel.app/phatthalung/weather

LINE_CHANNEL_ACCESS_TOKEN_TEST=
LINE_GROUP_ID_TEST=
LINE_CHANNEL_ACCESS_TOKEN_PROD=
LINE_GROUP_ID_PROD=

CONTENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_CONTENT_MODEL=gemini-3.8-flash
GEMINI_CONTENT_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

TTS_PROVIDER=gemini
TTS_PROFILE=male-friendly
TTS_VOICE_NAME=
TTS_VOICE_NAME_MALE=Achird
TTS_VOICE_NAME_FEMALE=Sulafat
TTS_LANGUAGE_CODE=th-TH
TTS_SPEAKING_RATE=0.92

THRESH_HOT_APPARENT=35
THRESH_COOL_MORNING=23
THRESH_RAIN_PROB_NOTABLE=40
THRESH_RAIN_PROB_HIGH=65
THRESH_STRONG_WIND_KMH=35
THRESH_HEAVY_RAIN_MM=10